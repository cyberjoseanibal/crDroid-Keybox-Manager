<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#090D16">

    <!-- Enterprise Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/app_header_logo"
            android:layout_marginRight="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="crDroid Keybox Manager"
                android:textSize="18.5sp"
                android:textStyle="bold"
                android:textColor="#F3F4F6"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tvSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sincronización Automática cada 3 Horas"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Ajustes"
            android:textSize="11sp"
            android:textColor="#E5E7EB"
            android:backgroundTint="#1F2937"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </LinearLayout>

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/card_shape"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado del Sistema"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprobando Root..."
                android:textColor="#10B981"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2937"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-Sincronización GitHub"
                    android:textColor="#F9FAFB"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reemplaza Keybox al detectar actualizaciones"
                    android:textColor="#9CA3AF"
                    android:textSize="10.5sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchAutoSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnCheckIntegrity"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Verificar Play Integrity"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D9488"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnUpdateKeybox"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Sincronizar Keybox Manualmente"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0284C7"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnUpdateTargets"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Aplicar Configuración Target Apps"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6D28D9"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnDeleteKeybox"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Eliminar Keybox del Sistema"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#991B1B"
        android:layout_marginBottom="10dp" />

    <!-- Terminal Console Header with Clear Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Registro de Eventos"
            android:textColor="#9CA3AF"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ Limpiar Registro ]"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Terminal Console -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#030712"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[INFO] crDroid Keybox Manager v2.4.0 listo.\n[INFO] Auto-sincronización activa."
            android:textColor="#34D399"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
