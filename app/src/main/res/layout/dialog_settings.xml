<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ajustes de Sincronización"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/accent_sky"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intervalo de Monitoreo GitHub:"
        android:textColor="@color/text_sub"
        android:textSize="12.5sp"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerInterval"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#050811"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URL del Repositorio Keybox:"
        android:textColor="@color/text_sub"
        android:textSize="12.5sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etGithubUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#050811"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/text_main"
        android:textSize="12sp"
        android:singleLine="true"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Guardar Ajustes"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/accent_blue" />

</LinearLayout>
