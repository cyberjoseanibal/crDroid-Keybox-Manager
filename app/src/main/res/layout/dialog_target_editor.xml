<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0A0F1D">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editor de Target Apps (Spoofing)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escribe o agrega los nombres de paquete de tus apps de bancos o juegos (uno por linea):"
        android:textColor="#9CA3AF"
        android:textSize="11.5sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etTargetApps"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#030712"
        android:padding="12dp"
        android:textColor="#F3F4F6"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="top|left"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnAddBankTemplate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="+ Añadir Apps por Defecto"
            android:textSize="10.5sp"
            android:textColor="#E5E7EB"
            android:backgroundTint="#1F2937"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnClearTargets"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Limpiar Todo"
            android:textSize="10.5sp"
            android:textColor="#FCA5A5"
            android:backgroundTint="#7F1D1D" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveAndApplyTargets"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Guardar y Aplicar en Sistema Root"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6D28D9" />

</LinearLayout>
